<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Management</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="navbar">
    <h1>Student Management System</h1>
  </header>

  <main class="container">
    <div class="toolbar">
      <form class="search-form" action="/students/search" method="GET">
        <input type="text" name="keyword" placeholder="Search student...">
        <button class="btn" type="submit">Search</button>
      </form>
      <a class="btn" href="/students/add">Add Student</a>
    </div>

    <div class="card">
      <h2>Student List</h2>
      <div class="table-wrapper">
        <table>
          <tr>
            <th>ID</th>
            <th>Student ID</th>
            <th>Name</th>
            <th>Course</th>
            <th>Year</th>
            <th>Email</th>
            <th>Actions</th>
          </tr>
          <% students.forEach(student => { %>
          <tr>
            <td><%= student.id %></td>
            <td><%= student.student_id %></td>
            <td><%= student.first_name %> <%= student.last_name %></td>
            <td><%= student.course %></td>
            <td><%= student.year_level %></td>
            <td><%= student.email %></td>
            <td>
            <div class="actions">
                <a class="btn btn-small" href="/students/edit/<%= student.id %>">Edit</a>
                <form class="inline-form" action="/students/delete/<%= student.id %>" method="POST"
                    onsubmit="return confirm('Delete this student?');">
                <button class="btn btn-danger btn-small" type="submit">Delete</button>
                </form>
            </div>
            </td>
          </tr>
        <% }); %>
        </table>
        <% if (students.length === 0) { %>
          <p>No matching records found.</p>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>